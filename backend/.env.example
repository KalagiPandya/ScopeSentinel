# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to GitHub.

DATABASE_URL=postgresql://scopeuser:scopepass@localhost:5432/scopesentinel
REDIS_URL=redis://localhost:6379
QDRANT_HOST=localhost
QDRANT_PORT=6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=scopesentinel_checkpoints

# LLM provider for Agents 1, 4, 6, 7 - "openai" or "ollama"
# openai: needs OPENAI_API_KEY below, costs money, has rate limits.
# ollama: runs a model locally, free, no rate limits, works offline.
#         Install Ollama (https://ollama.com), run `ollama pull llama3.1`,
#         then `ollama serve`, then set LLM_PROVIDER=ollama below.
LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Required only if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-real-key-here

# Optional - only if you wire up a Gemini-backed agent
GEMINI_API_KEY=your-gemini-key-here

JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

GITHUB_WEBHOOK_SECRET=change-me
APP_ENV=development
CORS_ORIGINS_RAW=http://localhost:5173,http://localhost:3000

# Jira integration (optional) - powers POST /jira/sync
# Generate an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://yourteam.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=SCOPE

# Email integration (optional) - powers POST /email/sync
# For Gmail, use an App Password (not your real password):
# https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=your-app-password
IMAP_MAILBOX=INBOX
